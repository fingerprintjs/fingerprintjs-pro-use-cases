SERVER_API_KEY=<SECRET_API_KEY>
NEXT_PUBLIC_API_KEY=<PUBLIC_API_KEY>
# "eu" or "ap", "us" is default
NEXT_PUBLIC_REGION=<REGION>
# Proxies that append to X-Forwarded-For after the client IP (0 = right-most hop)
# TRUSTED_PROXY_COUNT=0
# Public origin, needed when a proxy rewrites the Host header (e.g. CloudFront in front of Digital Ocean)
# PUBLIC_ORIGIN=https://demo.fingerprint.com